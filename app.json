{
  "expo": {
    "name": "SCHOOL",
    "slug": "school-native",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "backgroundColor": "#E6F4DC",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.school.preview"
    },
    "android": {
      "package": "com.school.preview",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "name": "SCHOOL"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar"
    ]
  }
}
