{
  "expo": {
    "name": "SCHOOL",
    "slug": "school-native",
    "version": "1.0.4",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "backgroundColor": "#E6F4DC",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.school.preview"
    },
    "android": {
      "package": "com.school.preview",
      "edgeToEdgeEnabled": true,
      "versionCode": 5
    },
    "web": {
      "bundler": "metro",
      "name": "SCHOOL",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F5EF"
    }
  }
}
